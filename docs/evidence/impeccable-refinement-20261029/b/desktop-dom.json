{
  "headings": [
    {
      "tag": "H1",
      "text": "讓工作更聰明，讓生活有餘裕。"
    },
    {
      "tag": "H2",
      "text": "把想像，做成日常。"
    },
    {
      "tag": "H3",
      "text": "潮間 Between Tides↗"
    },
    {
      "tag": "H3",
      "text": "霧裡山房 Mist House↗"
    },
    {
      "tag": "H3",
      "text": "從一則訊息，到一張清楚的訂單。"
    },
    {
      "tag": "H4",
      "text": "把需求收齊"
    },
    {
      "tag": "H4",
      "text": "安排取送"
    },
    {
      "tag": "H4",
      "text": "確認一張明細"
    },
    {
      "tag": "H3",
      "text": "日式民宿"
    },
    {
      "tag": "H3",
      "text": "洗務通 WashPass"
    },
    {
      "tag": "H2",
      "text": "好看之外，也要好用。"
    },
    {
      "tag": "H3",
      "text": "讓品牌，被好好看見。"
    },
    {
      "tag": "H3",
      "text": "讓日常，自己走下去。"
    },
    {
      "tag": "H3",
      "text": "讓回應，多一位幫手。"
    },
    {
      "tag": "H2",
      "text": "少一點忙亂。多一點餘裕。"
    },
    {
      "tag": "H3",
      "text": "事情很多，不必全靠你記住。"
    },
    {
      "tag": "H2",
      "text": "先聊生活，再聊技術。"
    },
    {
      "tag": "H3",
      "text": "聊聊現在"
    },
    {
      "tag": "H3",
      "text": "一起釐清"
    },
    {
      "tag": "H3",
      "text": "做出來，試著用"
    },
    {
      "tag": "H3",
      "text": "上線，也交接"
    },
    {
      "tag": "H2",
      "text": "開始之前，你可能想知道。"
    },
    {
      "tag": "H2",
      "text": "下一個好點子，從我們聊聊開始。"
    },
    {
      "tag": "H3",
      "text": "先說說，哪件事最想改善？"
    }
  ],
