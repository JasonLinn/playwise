# 複製成 .env.local（本機）或填到 Vercel → Settings → Environment Variables
# 詳細設定步驟：line/README.md

# 網站網址（LINE 訊息裡的圖片、連結會用到）
NEXT_PUBLIC_SITE_URL=https://playwise-nine.vercel.app

# LIFF ID（LINE Login channel → LIFF 分頁），例如 2001234567-AbCdEfGh
# 沒填時 /liff 會進入「預覽模式」，可在一般瀏覽器看畫面，但不會真的送出
NEXT_PUBLIC_LIFF_ID=

# Messaging API channel（官方帳號）→ Basic settings / Messaging API 分頁
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 收到表單、有人按「找真人聊」時要通知誰（你自己的 userId 或工作室群組 groupId，逗號分隔）
# 不知道 userId？設定好 Webhook 後，在官方帳號聊天室傳「#myid」就會回覆給你
LINE_ADMIN_TO=

# 選填：同步寫入 Google 試算表（line/google-apps-script/inquiry-sheet.gs）
INQUIRY_FORWARD_URL=

# 選填：LIFF 不在同一個 Login channel 時才需要；預設取 LIFF ID 的前半段
# LINE_LOGIN_CHANNEL_ID=

# 測試用：設為 1 時不真的呼叫 LINE API，只把訊息印在 log
# LINE_API_DRY_RUN=1
